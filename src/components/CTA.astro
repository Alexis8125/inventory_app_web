---
// src/components/CTA.astro
---

<div id="contacto" class="py-24 bg-gradient-to-br from-corporate-gray-900 to-corporate-gray-800 text-white">
  <div class="container mx-auto px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <span class="inline-block px-4 py-1.5 bg-white/10 backdrop-blur-sm text-white rounded-full text-sm font-semibold mb-6">
          SOLICITAR DEMOSTRACIÓN
        </span>
        <h2 class="text-3xl md:text-4xl font-display font-bold mb-6">
          Transforme su Gestión Empresarial con <span class="text-corporate-blue-300">AMS Inventory's</span>
        </h2>
        <p class="text-xl opacity-90 max-w-3xl mx-auto">
          Programe una demostración personalizada y descubra cómo podemos optimizar los procesos de su organización.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Form Column -->
        <div class="bg-white text-corporate-gray-900 rounded-2xl p-10 shadow-corporate-xl">
          <h3 class="text-2xl font-bold mb-8 text-corporate-gray-900">Solicitud de Demostración</h3>
          
          <form class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Nombre completo *</label>
                <input type="text" required class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900" placeholder="Ing. Juan Pérez" />
              </div>
              
              <div>
                <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Cargo *</label>
                <input type="text" required class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900" placeholder="Director de Operaciones" />
              </div>
            </div>
            
            <div>
              <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Correo electrónico corporativo *</label>
              <input type="email" required class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900" placeholder="nombre@empresa.com" />
            </div>
            
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Teléfono *</label>
                <input type="tel" required class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900" placeholder="+57 XXX XXX XXXX" />
              </div>
              
              <div>
                <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Empresa *</label>
                <input type="text" required class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900" placeholder="Nombre de su empresa" />
              </div>
            </div>
            
            <div>
              <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Sector empresarial *</label>
              <select class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900">
                <option>Seleccione su sector</option>
                <option>Retail / Comercio</option>
                <option>Manufactura</option>
                <option>Distribución / Logística</option>
                <option>Servicios</option>
                <option>Hospitalidad / Restaurantes</option>
                <option>Otro</option>
              </select>
            </div>
            
            <div>
              <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Tamaño de empresa (empleados) *</label>
              <select class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900">
                <option>Seleccione tamaño</option>
                <option>1-10 empleados</option>
                <option>11-50 empleados</option>
                <option>51-200 empleados</option>
                <option>201-500 empleados</option>
                <option>500+ empleados</option>
              </select>
            </div>
            
            <div>
              <label class="block text-corporate-gray-700 font-medium mb-3 text-sm">Desafíos específicos a resolver</label>
              <textarea rows="4" class="w-full px-4 py-3.5 bg-corporate-gray-50 border border-corporate-gray-200 rounded-xl focus:ring-2 focus:ring-corporate-blue-500 focus:border-transparent text-corporate-gray-900" placeholder="Describa brevemente los principales desafíos operativos que enfrenta su empresa..."></textarea>
            </div>
            
            <div class="flex items-center">
              <input type="checkbox" id="consent" class="w-5 h-5 rounded border-corporate-gray-300 text-corporate-blue-600 focus:ring-corporate-blue-500" />
              <label for="consent" class="ml-3 text-sm text-corporate-gray-600">
                Acepto recibir información sobre AMS Inventory's y autorizo el tratamiento de mis datos según la política de privacidad.
              </label>
            </div>
            
            <button type="submit" class="w-full bg-gradient-to-r from-corporate-blue-600 to-corporate-blue-700 text-white font-bold py-4 rounded-xl hover:shadow-corporate-xl transition-all hover:-translate-y-0.5 text-lg">
              Solicitar Demostración Personalizada
            </button>
            
            <p class="text-center text-sm text-corporate-gray-500">
              Nos pondremos en contacto en un plazo máximo de 24 horas hábiles.
            </p>
          </form>
        </div>

        <!-- Info Column -->
        <div class="lg:pl-8">
          <!-- Benefits -->
          <div class="mb-12">
            <h3 class="text-2xl font-bold mb-8">Beneficios de la Demostración</h3>
            <div class="space-y-6">
              <div class="flex items-start">
                <div class="w-12 h-12 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center mr-6 flex-shrink-0">
                  <span class="text-xl">🎯</span>
                </div>
                <div>
                  <h4 class="font-bold text-lg mb-2">Análisis Personalizado</h4>
                  <p class="opacity-90">Evaluaremos sus necesidades específicas y mostraremos cómo AMS Inventory's puede resolver sus desafíos.</p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="w-12 h-12 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center mr-6 flex-shrink-0">
                  <span class="text-xl">💼</span>
                </div>
                <div>
                  <h4 class="font-bold text-lg mb-2">Demo en Vivo</h4>
                  <p class="opacity-90">Acceso completo a la plataforma con casos de uso relevantes para su industria.</p>
                </div>
              </div>
              
              <div class="flex items-start">
                <div class="w-12 h-12 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center mr-6 flex-shrink-0">
                  <span class="text-xl">📈</span>
                </div>
                <div>
                  <h4 class="font-bold text-lg mb-2">Sin compromiso</h4>
                  <p class="opacity-90">La demo es gratuita y sin compromisos. Explore el sistema con sus propios casos de uso antes de decidir.</p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Contact Info -->
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20">
            <h3 class="text-2xl font-bold mb-8">Contacto Corporativo</h3>
            
            <div class="space-y-6">
              <div class="flex items-center">
                <div class="w-12 h-12 bg-corporate-blue-500/20 rounded-xl flex items-center justify-center mr-6">
                  <svg class="w-6 h-6 text-corporate-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold">Teléfono Corporativo</p>
                  <p class="opacity-90">+57 320 902 1560</p>
                </div>
              </div>
              
              <div class="flex items-center">
                <div class="w-12 h-12 bg-corporate-blue-500/20 rounded-xl flex items-center justify-center mr-6">
                  <svg class="w-6 h-6 text-corporate-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 3.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold">Email Corporativo</p>
                  <p class="opacity-90">ventas@softtechsystems.com.co</p>
                </div>
              </div>
              
              <div class="flex items-center">
                <div class="w-12 h-12 bg-corporate-blue-500/20 rounded-xl flex items-center justify-center mr-6">
                  <svg class="w-6 h-6 text-corporate-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold">Horario de Atención</p>
                  <p class="opacity-90">Lun-Vie: 8:00 - 18:00 hrs</p>
                  <p class="opacity-90 text-sm">Sáb: 9:00 - 14:00 hrs</p>
                </div>
              </div>
              
              <div class="flex items-center">
                <div class="w-12 h-12 bg-corporate-blue-500/20 rounded-xl flex items-center justify-center mr-6">
                  <svg class="w-6 h-6 text-corporate-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold">Ubicación</p>
                  <p class="opacity-90">Colombia</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Guarantee -->
      <div class="mt-20 text-center">
        <div class="inline-flex items-center bg-white/10 backdrop-blur-sm px-8 py-4 rounded-2xl border border-white/20">
          <div class="text-3xl mr-4">🛡️</div>
          <div class="text-left">
            <p class="font-bold text-lg">Garantía de Satisfacción</p>
            <p class="opacity-90 text-sm">Si después de la demostración no encuentra valor en nuestra solución, no habrá compromiso alguno.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>