---
// src/components/Features.astro
---

<div id="funcionalidades" class="py-24 bg-corporate-gray-50">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span class="inline-block px-4 py-1.5 bg-corporate-blue-100 text-corporate-blue-700 rounded-full text-sm font-semibold mb-6">
        MÓDULOS DEL SISTEMA
      </span>
      <h2 class="text-3xl md:text-4xl font-display font-bold text-corporate-gray-900 mb-6">
        Todo lo que tu negocio necesita <span class="text-corporate-blue-600">en un solo lugar</span>
      </h2>
      <p class="text-lg text-corporate-gray-600 font-light">
        15 módulos integrados que cubren cada área operativa de tu empresa, desde el inventario hasta la facturación.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">

      <!-- Inventario y Productos -->
      <div class="group bg-white rounded-2xl overflow-hidden border border-corporate-gray-200 hover:border-corporate-blue-300 transition-all duration-300 hover:shadow-corporate-xl">
        <div class="h-2 bg-gradient-to-r from-corporate-blue-500 to-corporate-blue-600"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-corporate-blue-50 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-corporate-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-corporate-gray-900 mb-4">Inventario y Productos</h3>
          <p class="text-corporate-gray-600 mb-6">
            Kardex automático con registro de cada movimiento. El stock se actualiza en tiempo real con cada venta, compra o alquiler.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-corporate-blue-100 text-corporate-blue-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Entradas y salidas con motivo y responsable</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-corporate-blue-100 text-corporate-blue-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Productos y servicios con precio de venta e IVA</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-corporate-blue-100 text-corporate-blue-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Alertas automáticas de stock bajo</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Ventas y Facturación -->
      <div class="group bg-white rounded-2xl overflow-hidden border border-corporate-gray-200 hover:border-corporate-blue-300 transition-all duration-300 hover:shadow-corporate-xl">
        <div class="h-2 bg-gradient-to-r from-accent-teal-500 to-accent-teal-600"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-green-50 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-corporate-gray-900 mb-4">Ventas y Facturación</h3>
          <p class="text-corporate-gray-600 mb-6">
            POS con carrito multi-producto. Cada venta genera automáticamente una factura con detalle por producto y registra el ingreso en caja.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Ventas a contado y a crédito con plazo</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Descuentos por venta, precios editables por ítem</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Factura PDF imprimible con detalle de productos</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Alquileres -->
      <div class="group bg-white rounded-2xl overflow-hidden border border-corporate-gray-200 hover:border-corporate-blue-300 transition-all duration-300 hover:shadow-corporate-xl">
        <div class="h-2 bg-gradient-to-r from-purple-500 to-purple-600"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-purple-50 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-corporate-gray-900 mb-4">Alquileres</h3>
          <p class="text-corporate-gray-600 mb-6">
            Contratos de alquiler con múltiples productos por contrato. El stock queda comprometido desde que se crea la reserva y se libera al devolver.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Depósito de garantía y abono por adelantado</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Estados: Reservado → Entregado → Devuelto</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Recibo de contrato imprimible</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Suscripciones y Créditos -->
      <div class="group bg-white rounded-2xl overflow-hidden border border-corporate-gray-200 hover:border-corporate-blue-300 transition-all duration-300 hover:shadow-corporate-xl">
        <div class="h-2 bg-gradient-to-r from-orange-500 to-orange-600"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-orange-50 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-corporate-gray-900 mb-4">Suscripciones y Créditos</h3>
          <p class="text-corporate-gray-600 mb-6">
            Facturación automática de suscripciones al vencer. Seguimiento de cartera con estado de cada crédito y registro de abonos parciales.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Cobro automático al vencer la suscripción</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Cuenta de cobro anticipada imprimible</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Clientes con deuda visible desde el dashboard</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Reportes y Caja -->
      <div class="group bg-white rounded-2xl overflow-hidden border border-corporate-gray-200 hover:border-corporate-blue-300 transition-all duration-300 hover:shadow-corporate-xl">
        <div class="h-2 bg-gradient-to-r from-corporate-gray-700 to-corporate-gray-800"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-corporate-gray-100 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-corporate-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-corporate-gray-900 mb-4">Reportes y Caja</h3>
          <p class="text-corporate-gray-600 mb-6">
            Reportes por tipo (ventas, compras, alquileres, utilidades, inventario, clientes) con filtros de fecha y exportación a PDF. Caja con movimientos automáticos desde ventas.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-corporate-gray-200 text-corporate-gray-700 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Filtros: hoy, semana, mes, año, personalizado</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-corporate-gray-200 text-corporate-gray-700 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Dashboard con ingresos por fuente (ventas, alquileres, suscripciones)</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-corporate-gray-200 text-corporate-gray-700 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Exportar reporte a PDF con un clic</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Multi-empresa y Usuarios -->
      <div class="group bg-white rounded-2xl overflow-hidden border border-corporate-gray-200 hover:border-corporate-blue-300 transition-all duration-300 hover:shadow-corporate-xl">
        <div class="h-2 bg-gradient-to-r from-blue-400 to-cyan-500"></div>
        <div class="p-8">
          <div class="w-16 h-16 bg-cyan-50 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-corporate-gray-900 mb-4">Usuarios y Multi-empresa</h3>
          <p class="text-corporate-gray-600 mb-6">
            Plataforma multi-tenant: cada empresa tiene su propio espacio aislado. Control de acceso por roles con registro de auditoría de todas las acciones.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-cyan-100 text-cyan-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>4 roles: Administrador, Vendedor, Bodega, Contabilidad</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-cyan-100 text-cyan-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Registro de auditoría: quién hizo qué y cuándo</span>
            </li>
            <li class="flex items-center text-sm">
              <div class="w-5 h-5 rounded-full bg-cyan-100 text-cyan-600 flex items-center justify-center mr-3 flex-shrink-0">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              </div>
              <span>Superadmin para gestión de empresas y planes</span>
            </li>
          </ul>
        </div>
      </div>

    </div>

    <div class="mt-16 text-center">
      <a href="#contacto" class="inline-flex items-center bg-gradient-to-r from-corporate-blue-600 to-corporate-blue-700 text-white px-10 py-4 rounded-xl font-semibold text-lg hover:shadow-corporate-xl transition-all hover:-translate-y-0.5">
        Solicitar acceso de prueba
        <svg class="w-5 h-5 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>
